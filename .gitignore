*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.iml

# OS 별 불필요 파일
.DS_Store
Thumbs.db

# Addressables / ShaderCache
